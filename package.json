{
  "name": "mayahtrip-backend",
  "version": "1.0.0",
  "description": "API do MayahTrip (NestJS, DDD).",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migration:run": "tsx scripts/run-migrations.ts",
    "migration:revert": "tsx scripts/revert-migration.ts"
  },
  "repository": {
    "type": "git",
    "url": "git@github-personal:jeanlucas395ps/mayahtrip-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26.13.1"
  },
  "dependencies": {
    "@google-cloud/storage": "^9.0.0",
    "@nestjs/common": "^12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/typeorm": "^12.0.3",
    "@prometheus-io/client": "^0.16.1",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "i18next": "^27.1.3",
    "ioredis": "^5.11.1",
    "joi": "^18.3.2",
    "nest-winston": "^2.0.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "typeorm": "^1.1.3",
    "winston": "^3.19.0"
  },
  "allowScripts": {
    "argon2@0.45.2": true,
    "@swc/core@1.16.22": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "devDependencies": {
    "@nestjs/testing": "^12.5.0",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "dotenv": "^18.0.10",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typeorm-extension": "^4.4.0",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
