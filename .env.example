# Copie para .env e preencha. Segredo de produção nunca entra no Git (RULES.md §5).

NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=mayahtrip
DB_PASSWORD=mayahtrip
DB_NAME=mayahtrip

REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=troque-este-valor-em-produção
JWT_ACCESS_TTL_SECONDS=900

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MayahTrip <no-reply@mayahtrip.com>"

SIGN_UP_CODE_TTL_MINUTES=10
# Não cria mais um limite só do cadastro. O guard único está abaixo.
SIGN_UP_RATE_LIMIT_PER_MINUTE=5

# Guard único de toda a API. O número de produto continua em aberto.
# Estes são os valores que o processo já usava (120 por minuto).
RATE_LIMIT_LIMITE=120
RATE_LIMIT_JANELA_MS=60000

# Proposta da ADR 0001, ainda não fechada: 30 dias com manter conectado, 1 dia sem.
REFRESH_TTL_MANTER_CONECTADO_SEGUNDOS=2592000
REFRESH_TTL_SEM_MANTER_CONECTADO_SEGUNDOS=86400
# Proposta da spec 047, ainda não fechada.
HANDOFF_TTL_SEGUNDOS=60

# Opcional. Nome usado pelo próprio ReadMe. Só é enviada quando NODE_ENV
# é development ou test. Vazio: /readme continua no ar nesses ambientes,
# sem publicar. Nunca preencha com chave de produção neste arquivo.
README_API_KEY=
