# Copie para .env e preencha. Segredo de produção nunca entra no Git (RULES.md §5).

NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=mayahtrip
DB_PASSWORD=mayahtrip
DB_NAME=mayahtrip

REDIS_URL=redis://:mayahtrip@127.0.0.1:6379

JWT_ACCESS_SECRET=troque-este-valor-em-produção
JWT_ACCESS_TTL_SECONDS=900

# A API Nest lê SMTP_* (com fallback para MAIL_* se SMTP_USER estiver vazio).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MayahTrip <cto@bracav.com.br>"

# Opcional: envio por HTTPS (api.resend.com) quando a rede bloqueia SMTP.
# RESEND_API_KEY=re_xxx

SIGN_UP_CODE_TTL_MINUTES=10
SIGN_UP_RATE_LIMIT_PER_MINUTE=5

# Alias Laravel-style (mesmo Hostinger). Preferir preencher SMTP_* acima.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=cto@bracav.com.br
MAIL_FROM_NAME=MayahTrip

# Google OAuth Configuration (web = audience do idToken; iOS = GIDClientID)
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Opcional: se SMTP 465/587 estiver bloqueado na rede, use Resend (HTTPS)
# RESEND_API_KEY=

GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

OPENAI_API_KEY=

# GPT-5.x Responses API (ChatGpt5CallerService , api_family=gpt5)
OPENAI_GPT5_API_URL="https://api.openai.com/v1/responses"
OPENAI_GPT5_TIMEOUT=90
CHAT_HIBRIDO_MAX_EXECUTION=180
OPENAI_GPT5_STORE=false
OPENAI_GPT5_MODEL=gpt-5
OPENAI_GPT5_REASONING_EFFORT=low
OPENAI_GPT5_VERBOSITY=low

FILESYSTEM_DISK=gcs
GCS_PROJECT_ID=project-9ba08999-0ea7-47f5-ad7
GCS_KEY_FILE=storage/secrets/mayahtrip-storage-gcs-key.json
GCS_BUCKET_PLACES=mayahtrip-places_HML
GCS_BUCKET_DB_BACKUPS=mayahtrip-database-backup_HML
GCS_PATH_PREFIX=
GCS_STORAGE_API_URI=

ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_API_URL=https://sandbox.asaas.com/api/v3

# Token do webhook no painel Asaas (header asaas-access-token nas chamadas recebidas)
ASAAS_WEBHOOK_TOKEN=

# Origens permitidas para CORS (API), separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:3001

TIKTOK_API_ENABLED=true
TIKTOK_LOG_REQUESTS=true
TIKTOK_API_PROVIDER=rapidapi
TIKTOK_API_BASE_URL=https://tiktok-api23.p.rapidapi.com
TIKTOK_API_KEY=
TIKTOK_RAPIDAPI_HOST=tiktok-api23.p.rapidapi.com
TIKTOK_SEARCH_PATH=/api/search/video
TIKTOK_QUERY_PARAM=keyword
TIKTOK_MAX_VIDEOS=15
TIKTOK_TIMEOUT=25
TIKTOK_CACHE_TTL_DAYS=7

RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_PER_MINUTE=20
RATE_LIMIT_API_PER_HOUR=2000
RATE_LIMIT_API_PER_DAY=10000
